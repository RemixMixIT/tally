# Required
TALLY_MASTER_KEY=         # `openssl rand -base64 32` — encrypts OAuth tokens at rest
TALLY_FIREFLY_URL=http://firefly-iii:8080
TALLY_FIREFLY_TOKEN=      # Firefly III Personal Access Token (Profile → OAuth)
TALLY_TRUELAYER_CLIENT_ID=
TALLY_TRUELAYER_CLIENT_SECRET=
TALLY_REDIRECT_URI_BASE=https://tally.example.com/auth   # your public TrueLayer redirect host

# MCP connector auth — external OIDC authorization server (Authentik / Keycloak).
# tally validates the IdP's JWTs on /mcp; it does NOT run its own OAuth server, and there is
# NO API-token fallback on /mcp. If these are unset, /mcp is disabled (401 for all callers).
# TALLY_OIDC_ISSUER=https://auth.example.com/application/o/tally/
# TALLY_OIDC_AUDIENCE=tally-mcp
# TALLY_OIDC_JWKS_URL=                 # optional; defaults to <issuer>/jwks/

# Queeg hub SSO: same value as BRAIN_SECRET on /home/john/apps/brain/.env
# QUEEG_SSO_SECRET=

# Set when tally is served over HTTPS (adds Secure to the session cookie).
# TALLY_SECURE_COOKIES=true

# Set ONLY when a trusted reverse proxy sits directly in front of tally. Auth rate
# limiting then keys on the last X-Forwarded-For hop instead of the TCP peer address.
# Without a proxy, leave unset — a spoofed header could otherwise bypass lockouts.
# TALLY_TRUST_PROXY=true

# Optional
TALLY_PORT=3001
TALLY_DATABASE_URL=sqlite:///app/data/state.db
TALLY_SYNC_CRON="0 7 0,6,12,18 * * *"  # 6-field cron; 4× daily (AIS unattended cap)
# Batty valuation CSV (rclone-copied onto the inbound bind mount).
# TALLY_VALUATION_FEED_PATH=/app/inbound/tally_valuations.csv
# Vanquis PDF drop-folder (host rclone copies into this dir).
# Drop: dropbox:!Inbox/Documents/Vanquis Statements
# Archive: onedrive:Documents/Financial/Vanquis Statements
# TALLY_VANQUIS_DIR=/app/inbound/vanquis
# TALLY_VANQUIS_ACCOUNT_ID=29
# Capital on Tap PDF drop-folder (host rclone copies into this dir).
# Drop: dropbox:!Inbox/Documents/CapitalOnTap Statements
# Archive: onedrive:Documents/Financial/CapitalOnTap Statements
# TALLY_CAPITAL_ON_TAP_DIR=/app/inbound/capital-on-tap
# TALLY_CAPITAL_ON_TAP_ACCOUNT_ID=30

# Package C receipt poller. Ships off. Set TALLY_IMMICH_RECEIPTS=1 only after the
# matcher checks pass and an API key with tag.read, asset.read, and asset.download
# is available. The adapter lists and downloads; it does not create, update, or untag.
# TALLY_IMMICH_RECEIPTS=0
# On Speed, tally joins the immich_default network. The host loopback publish
# is not reachable from the tally container.
# TALLY_IMMICH_BASE_URL=http://immich_server:2283
# TALLY_IMMICH_API_KEY=
# TALLY_RECEIPT_DIR=/app/data/receipts
# TALLY_RECEIPT_POLL_CRON=0 */2 * * * *

# Optional notification hooks (silently disabled if unset)
# TALLY_HA_URL=http://homeassistant:8123
# TALLY_HA_TOKEN=                  # HA long-lived access token
# TALLY_TELEGRAM_BOT_TOKEN=
# TALLY_TELEGRAM_CHAT_ID=
# TALLY_TELEGRAM_MIN_AMOUNT=0       # only notify on |amount| ≥ this
